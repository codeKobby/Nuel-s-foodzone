# Firebase Web App configuration (safe to expose to the browser)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=nuels-cafe
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Public allowlist identifier; this is not a password or secret.
NEXT_PUBLIC_MANAGER_EMAIL=nuelgee54@gmail.com

# Trusted server/Admin SDK configuration.
# Prefer GOOGLE_APPLICATION_CREDENTIALS pointing to a local service-account
# JSON file during development, or the hosting platform's workload identity in
# deployment. Do not commit service-account JSON or private keys.
FIREBASE_PROJECT_ID=nuels-cafe
GOOGLE_APPLICATION_CREDENTIALS=
